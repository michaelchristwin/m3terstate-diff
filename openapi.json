  "components": {
    "schemas": {
      "Meter": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "meterId": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Meter ID, 0 through 17179869183."
          },
          "accountWh": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Cumulative whole watt-hours, maximum 1099511627775."
          },
          "nonce": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Last accepted nonce, maximum 16777215."
          }
        },
        "required": [
          "meterId",
          "accountWh",
          "nonce"
        ]
      },
      "Word": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slot": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Unsigned decimal integer encoded as a string."
          },
          "word": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Unsigned decimal integer encoded as a string."
          },
          "meters": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "$ref": "#/components/schemas/Meter"
            }
          }
        },
        "required": [
          "slot",
          "word",
          "meters"
        ]
      },
      "Event": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "chainId": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Unsigned decimal integer encoded as a string."
          },
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{40}$"
          },
          "topics": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            }
          },
          "data": {
            "type": "string",
            "pattern": "^0x([0-9a-fA-F]{2})*$",
            "description": "Full ABI-encoded event data."
          },
          "updates": {
            "type": "string",
            "pattern": "^0x([0-9a-fA-F]{2})*$",
            "description": "Unwrapped concatenated 36-byte replacements."
          },
          "blockNumber": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Unsigned decimal integer encoded as a string."
          },
          "blockHash": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "timestamp": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Block Unix timestamp in seconds."
          },
          "transactionHash": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "transactionIndex": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Unsigned decimal integer encoded as a string."
          },
          "logIndex": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Unsigned decimal integer encoded as a string."
          },
          "words": {
            "type": "array",
