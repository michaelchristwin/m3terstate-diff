{
  "openapi": "3.0.3",
  "info": {
    "title": "M3terstate Indexer API",
    "version": "1.0.0",
    "description": "REST access to a single configured chain/contract/topic stream indexed from Etherscan V2. No live proxy. Reorg recovery and replay may replace recently indexed data; consult /v1/status. Pagination is deterministic per query, not a snapshot across requests."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Indexer"
    },
    {
      "name": "Operations"
    }
  ],
