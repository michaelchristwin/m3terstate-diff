    "/v1/meters/{meterId}": {
      "get": {
        "operationId": "getMeter",
        "summary": "Get a materialized current meter",
        "description": "404 means no indexed word replacement exists for this meter; after a complete replay of a fresh deployment its implicit state is zero.",
        "tags": [
          "Indexer"
        ],
        "parameters": [
          {
            "name": "meterId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^([0-9]+|0x[0-9a-fA-F]+)$"
