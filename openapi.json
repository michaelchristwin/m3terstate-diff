    "/v1/events": {
      "get": {
        "operationId": "listEvents",
        "summary": "List indexed events with decoded meter state",
        "description": "Results come exclusively from PostgreSQL. Blocks and numeric quantities are decimal strings. Stable ordering uses block number then block-wide log index. No API key, module, or action parameters are accepted. Each event includes words[].meters[] with meterId, cumulative accountWh, and nonce, matching the single-event endpoint. Accounts are whole watt-hours, not milliwatt-hours.",
        "tags": [
          "Indexer"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/fromBlock"
          },
          {
            "$ref": "#/components/parameters/toBlock"
          },
          {
            "$ref": "#/components/parameters/chainid"
          },
          {
            "$ref": "#/components/parameters/address"
          },
