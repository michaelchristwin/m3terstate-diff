            "$ref": "#/components/parameters/topic1"
          },
          {
            "$ref": "#/components/parameters/topic2"
          },
          {
            "$ref": "#/components/parameters/topic3"
          },
          {
            "$ref": "#/components/parameters/topic0_1_opr"
          },
          {
            "$ref": "#/components/parameters/topic0_2_opr"
          },
          {
            "$ref": "#/components/parameters/topic0_3_opr"
          },
          {
            "$ref": "#/components/parameters/topic1_2_opr"
          },
          {
            "$ref": "#/components/parameters/topic1_3_opr"
          },
          {
            "$ref": "#/components/parameters/topic2_3_opr"
          },
          {
            "$ref": "#/components/parameters/page"
          },
          {
            "$ref": "#/components/parameters/offset"
          },
          {
            "$ref": "#/components/parameters/sort"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query or path parameter",
            "content": {
